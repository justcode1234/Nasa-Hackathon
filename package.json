{
  "name": "fieldshift",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "NASA POWER evidence and transparent crop-rotation screening",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-browser.js",
    "prestart": "node scripts/build-browser.js",
    "start": "node scripts/static-preview.js",
    "start:node": "node scripts/node-preview.js",
    "prestart:showcase": "node scripts/build-browser.js",
    "start:showcase": "node scripts/static-preview.js",
    "dev": "node --watch scripts/static-preview.js",
    "dev:node": "node --watch scripts/node-preview.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node scripts/live-validation.js",
    "test:browser": "node scripts/browser-validation.js",
    "test:node-browser": "node scripts/node-browser-validation.js",
    "test:firefox": "node scripts/firefox-validation.js",
    "test:qa": "node scripts/qa-validation.js",
    "test:e2e": "npm run build && playwright test",
    "test:place-audit": "node scripts/audit-matrix.js --deep",
    "test:chat-place": "node scripts/chat-place-probe.mjs",
    "test:chat-matrix": "node scripts/chat-place-matrix-probe.mjs",
    "test:country-spelling": "node scripts/country-spelling-cross-engine-probe.mjs",
    "test:release": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tensorflow/tfjs": "4.22.0",
    "axe-core": "4.10.2",
    "esbuild": "0.28.2"
  }
}
